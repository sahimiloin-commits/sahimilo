{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sahimilo",
  "compatibility_date": "2026-09-17",
  "routes": [
    {
      "pattern": "sahimilo.in",
      "custom_domain": true
    },
    {
      "pattern": "www.sahimilo.in",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
